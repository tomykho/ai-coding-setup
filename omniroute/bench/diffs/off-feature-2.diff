+import argparse
+import sys
+
+from inventory.report import run_report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="python3 -m inventory")
+    sub = parser.add_subparsers(dest="command", required=True)
+    rep = sub.add_parser("report", help="print inventory report as CSV")
+    rep.add_argument("--category")
+    rep.add_argument("--warehouse")
+    rep.add_argument("--min-qty", type=int)
+    rep.add_argument("--out", metavar="FILE")
+    args = parser.parse_args(argv)
+    if args.command == "report":
+        run_report(category=args.category, warehouse=args.warehouse,
+                   min_qty=args.min_qty, out_path=args.out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
