+import csv
+import io
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from inventory.core import Item, load
+from inventory.report import FIELDS, build_rows, write_report, run_report
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def item(sku, qty, price, category="c", warehouse="n"):
+    return Item(sku, "name-" + sku, category, qty, price, warehouse)
+
+
+class BuildRowsTests(unittest.TestCase):
+    def test_value_and_fields(self):
+        rows = build_rows([item("a", 3, 100)])
+        self.assertEqual(rows, [{"sku": "a", "name": "name-a", "category": "c",
+                                 "qty": 3, "price_cents": 100, "value_cents": 300}])
+
+    def test_sorted_by_value_desc_then_sku_asc(self):
+        items = [item("b", 1, 100), item("a", 1, 100), item("c", 2, 200), item("d", 10, 1)]
+        self.assertEqual([r["sku"] for r in build_rows(items)], ["c", "a", "b", "d"])
+
+    def test_category_filter(self):
+        items = [item("a", 1, 1, category="x"), item("b", 1, 1, category="y")]
+        self.assertEqual([r["sku"] for r in build_rows(items, category="y")], ["b"])
+
+    def test_warehouse_filter(self):
+        items = [item("a", 1, 1, warehouse="n"), item("b", 1, 1, warehouse="w")]
+        self.assertEqual([r["sku"] for r in build_rows(items, warehouse="w")], ["b"])
+
+    def test_min_qty_inclusive(self):
+        items = [item("a", 4, 1), item("b", 5, 1), item("c", 6, 1)]
+        self.assertEqual({r["sku"] for r in build_rows(items, min_qty=5)}, {"b", "c"})
+
+    def test_filters_combine_with_and(self):
+        items = [item("a", 9, 1, category="x", warehouse="n"),
+                 item("b", 9, 1, category="x", warehouse="w"),
+                 item("c", 1, 1, category="x", warehouse="w"),
+                 item("d", 9, 1, category="y", warehouse="w")]
+        rows = build_rows(items, category="x", warehouse="w", min_qty=2)
+        self.assertEqual([r["sku"] for r in rows], ["b"])
+
+    def test_no_matches(self):
+        self.assertEqual(build_rows([item("a", 1, 1)], category="zzz"), [])
+
+
+class WriteReportTests(unittest.TestCase):
+    def test_csv_header_and_rows(self):
+        buf = io.StringIO()
+        write_report(buf, build_rows([item("a", 2, 50)]))
+        self.assertEqual(buf.getvalue(),
+                         "sku,name,category,qty,price_cents,value_cents\n"
+                         "a,name-a,c,2,50,100\n")
+
+    def test_header_only_when_empty(self):
+        buf = io.StringIO()
+        write_report(buf, [])
+        self.assertEqual(buf.getvalue(), ",".join(FIELDS) + "\n")
+
+
+class RunReportTests(unittest.TestCase):
+    def test_writes_to_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "out.csv")
+            run_report(out_path=path, items=[item("a", 1, 1), item("b", 2, 2)])
+            with open(path, newline="") as f:
+                rows = list(csv.DictReader(f))
+            self.assertEqual([r["sku"] for r in rows], ["b", "a"])
+            self.assertEqual(rows[0]["value_cents"], "4")
+
+    def test_full_dataset_sorted(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "out.csv")
+            rows = run_report(out_path=path)
+            self.assertEqual(len(rows), len(load()))
+            keys = [(-r["value_cents"], r["sku"]) for r in rows]
+            self.assertEqual(keys, sorted(keys))
+
+
+class CliTests(unittest.TestCase):
+    def _run(self, *args):
+        return subprocess.run([sys.executable, "-m", "inventory", "report", *args],
+                              cwd=ROOT, capture_output=True, text=True, check=True)
+
+    def test_stdout_default(self):
+        out = self._run("--min-qty", "1000000").stdout
+        self.assertEqual(out, "sku,name,category,qty,price_cents,value_cents\n")
+
+    def test_stdout_has_header_and_rows(self):
+        lines = self._run("--category", "garden").stdout.splitlines()
+        self.assertEqual(lines[0], "sku,name,category,qty,price_cents,value_cents")
+        self.assertTrue(len(lines) > 1)
+        self.assertTrue(all(l.split(",")[2] == "garden" for l in lines[1:]))
+
+    def test_out_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "r.csv")
+            stdout = self._run("--warehouse", "north", "--min-qty", "5", "--out", path).stdout
+            self.assertEqual(stdout, "")
+            with open(path, newline="") as f:
+                rows = list(csv.DictReader(f))
+            self.assertTrue(rows)
+            self.assertTrue(all(int(r["qty"]) >= 5 for r in rows))
+            self.assertTrue(all(int(r["value_cents"]) == int(r["qty"]) * int(r["price_cents"])
+                                for r in rows))
+
+
+if __name__ == "__main__":
+    unittest.main()
