+import contextlib
+import csv
+import io
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from inventory.core import Item, load
+from inventory.report import build_rows, run, HEADER
+from inventory.__main__ import main
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def items():
+    return [
+        Item("SKU2", "b", "tools", 2, 100, "north"),   # value 200
+        Item("SKU1", "a", "tools", 4, 50, "west"),     # value 200 (tie, sku sorts first)
+        Item("SKU3", "c", "garden", 10, 30, "north"),  # value 300
+        Item("SKU4", "d", "garden", 1, 10, "west"),    # value 10
+    ]
+
+
+class BuildRowsTests(unittest.TestCase):
+    def test_value_and_sort_order(self):
+        rows = build_rows(items())
+        self.assertEqual([r["sku"] for r in rows], ["SKU3", "SKU1", "SKU2", "SKU4"])
+        self.assertEqual(rows[0]["value_cents"], 300)
+
+    def test_row_keys(self):
+        self.assertEqual(list(build_rows(items())[0].keys()), HEADER)
+
+    def test_category_filter(self):
+        self.assertEqual({r["category"] for r in build_rows(items(), category="garden")}, {"garden"})
+
+    def test_warehouse_filter(self):
+        self.assertEqual({r["sku"] for r in build_rows(items(), warehouse="west")}, {"SKU1", "SKU4"})
+
+    def test_min_qty_inclusive(self):
+        self.assertEqual({r["sku"] for r in build_rows(items(), min_qty=2)}, {"SKU1", "SKU2", "SKU3"})
+
+    def test_filters_combine_with_and(self):
+        rows = build_rows(items(), category="tools", warehouse="north", min_qty=2)
+        self.assertEqual([r["sku"] for r in rows], ["SKU2"])
+
+    def test_no_match_gives_empty(self):
+        self.assertEqual(build_rows(items(), category="nope"), [])
+
+
+class RunTests(unittest.TestCase):
+    def test_stdout_csv(self):
+        buf = io.StringIO()
+        run(items=items(), stdout=buf)
+        lines = buf.getvalue().splitlines()
+        self.assertEqual(lines[0], "sku,name,category,qty,price_cents,value_cents")
+        self.assertEqual(lines[1], "SKU3,c,garden,10,30,300")
+        self.assertEqual(len(lines), 5)
+
+    def test_out_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "r.csv")
+            run(items=items(), min_qty=5, out=path)
+            with open(path, newline="") as f:
+                rows = list(csv.DictReader(f))
+        self.assertEqual([r["sku"] for r in rows], ["SKU3"])
+
+
+class CliTests(unittest.TestCase):
+    def test_main_stdout(self):
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            self.assertEqual(main(["report", "--category", "garden"]), 0)
+        lines = buf.getvalue().splitlines()
+        self.assertEqual(lines[0], ",".join(HEADER))
+        expected = sum(1 for i in load() if i.category == "garden")
+        self.assertEqual(len(lines), 1 + expected)
+        self.assertTrue(all(l.split(",")[2] == "garden" for l in lines[1:]))
+
+    def test_main_out_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "r.csv")
+            self.assertEqual(main(["report", "--warehouse", "west", "--out", path]), 0)
+            with open(path, newline="") as f:
+                reader = csv.reader(f)
+                self.assertEqual(next(reader), HEADER)
+                rows = list(reader)
+        self.assertTrue(rows)
+
+    def test_module_entrypoint(self):
+        out = subprocess.run([sys.executable, "-m", "inventory", "report", "--min-qty", "1000000"],
+                             cwd=ROOT, capture_output=True, text=True, check=True).stdout
+        self.assertEqual(out, ",".join(HEADER) + "\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
