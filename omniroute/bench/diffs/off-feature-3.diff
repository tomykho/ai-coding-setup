+import argparse
+import sys
+
+from inventory.report import report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="python3 -m inventory")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    rep = sub.add_parser("report", help="print stock items as CSV")
+    rep.add_argument("--category", help="only items in this category")
+    rep.add_argument("--warehouse", help="only items in this warehouse")
+    rep.add_argument("--min-qty", type=int, help="only items with qty >= N")
+    rep.add_argument("--out", metavar="FILE", help="write CSV to FILE instead of stdout")
+
+    args = parser.parse_args(argv)
+    if args.command == "report":
+        report(category=args.category, warehouse=args.warehouse,
+               min_qty=args.min_qty, out=args.out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/inventory/report.py b/inventory/report.py
new file mode 100644
index 0000000..9424df8
--- /dev/null
+++ b/inventory/report.py
@@ -0,0 +1,47 @@
+import csv
+import sys
+
+from inventory.core import load
+
+FIELDS = ["sku", "name", "category", "qty", "price_cents", "value_cents"]
+
+
+def build_rows(items, category=None, warehouse=None, min_qty=None):
+    """Filter items (AND-combined), add value_cents, sort by value desc then sku asc."""
+    rows = []
+    for i in items:
+        if category is not None and i.category != category:
+            continue
+        if warehouse is not None and i.warehouse != warehouse:
+            continue
+        if min_qty is not None and i.qty < min_qty:
+            continue
+        rows.append({
+            "sku": i.sku,
+            "name": i.name,
+            "category": i.category,
+            "qty": i.qty,
+            "price_cents": i.price_cents,
+            "value_cents": i.qty * i.price_cents,
+        })
+    rows.sort(key=lambda r: (-r["value_cents"], r["sku"]))
+    return rows
+
+
+def write_csv(rows, stream):
+    writer = csv.DictWriter(stream, fieldnames=FIELDS, lineterminator="\n")
+    writer.writeheader()
+    writer.writerows(rows)
+
+
+def report(category=None, warehouse=None, min_qty=None, out=None, items=None):
+    """Write the report to `out` (a file path) or stdout when out is None."""
+    if items is None:
+        items = load()
+    rows = build_rows(items, category, warehouse, min_qty)
+    if out is None:
+        write_csv(rows, sys.stdout)
+    else:
+        with open(out, "w", newline="") as f:
+            write_csv(rows, f)
+    return rows
diff --git a/tests/test_report.py b/tests/test_report.py
