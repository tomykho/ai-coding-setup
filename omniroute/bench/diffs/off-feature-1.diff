+import argparse
+import sys
+
+from inventory import report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="python3 -m inventory")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    rep = sub.add_parser("report", help="print inventory items as CSV, sorted by stock value")
+    rep.add_argument("--category", help="only items in this category")
+    rep.add_argument("--warehouse", help="only items in this warehouse")
+    rep.add_argument("--min-qty", type=int, help="only items with qty >= N")
+    rep.add_argument("--out", metavar="FILE", help="write to FILE instead of stdout")
+
+    args = parser.parse_args(argv)
+    if args.command == "report":
+        report.run(category=args.category, warehouse=args.warehouse,
+                   min_qty=args.min_qty, out=args.out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
