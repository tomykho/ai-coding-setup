+import csv
+import io
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from inventory import report
+from inventory.core import Item, load
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+SAMPLE = [
+    Item("S3", "c", "tools", 2, 100, "north"),   # value 200
+    Item("S1", "a", "garden", 4, 50, "west"),    # value 200 (tie, sku sorts first)
+    Item("S2", "b", "tools", 10, 30, "north"),   # value 300
+    Item("S4", "d", "tools", 1, 10, "west"),     # value 10
+]
+
+
+def parse(text):
+    return list(csv.DictReader(io.StringIO(text)))
+
+
+class BuildRowsTests(unittest.TestCase):
+    def test_value_and_sort_order(self):
+        rows = report.build_rows(SAMPLE)
+        self.assertEqual([r["sku"] for r in rows], ["S2", "S1", "S3", "S4"])
+        self.assertEqual(rows[0]["value_cents"], 300)
+        self.assertEqual(rows[1]["value_cents"], 200)
+
+    def test_category_filter(self):
+        rows = report.build_rows(SAMPLE, category="tools")
+        self.assertEqual({r["sku"] for r in rows}, {"S2", "S3", "S4"})
+
+    def test_warehouse_filter(self):
+        rows = report.build_rows(SAMPLE, warehouse="west")
+        self.assertEqual({r["sku"] for r in rows}, {"S1", "S4"})
+
+    def test_filters_combine_with_and(self):
+        rows = report.build_rows(SAMPLE, category="tools", warehouse="north")
+        self.assertEqual({r["sku"] for r in rows}, {"S2", "S3"})
+        self.assertEqual(report.build_rows(SAMPLE, category="garden", warehouse="north"), [])
+
+    def test_min_qty_inclusive(self):
+        rows = report.build_rows(SAMPLE, min_qty=2)
+        self.assertEqual({r["sku"] for r in rows}, {"S1", "S2", "S3"})
+
+    def test_min_qty_zero_keeps_all(self):
+        self.assertEqual(len(report.build_rows(SAMPLE, min_qty=0)), 4)
+
+    def test_no_match_gives_no_rows(self):
+        self.assertEqual(report.build_rows(SAMPLE, category="nope"), [])
+
+    def test_row_fields(self):
+        row = report.build_rows(SAMPLE)[0]
+        self.assertEqual(list(row), report.FIELDS)
+        self.assertEqual(row["value_cents"], row["qty"] * row["price_cents"])
+
+
+class RunTests(unittest.TestCase):
+    def test_stdout_output(self):
+        buf = io.StringIO()
+        report.run(items=SAMPLE, stdout=buf)
+        lines = buf.getvalue().splitlines()
+        self.assertEqual(lines[0], "sku,name,category,qty,price_cents,value_cents")
+        self.assertEqual(lines[1], "S2,b,tools,10,30,300")
+        self.assertEqual(len(lines), 5)
+
+    def test_out_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "r.csv")
+            report.run(items=SAMPLE, min_qty=2, out=path)
+            with open(path, newline="") as f:
+                rows = parse(f.read())
+        self.assertEqual([r["sku"] for r in rows], ["S2", "S1", "S3"])
+
+    def test_default_data_is_sorted(self):
+        rows = report.build_rows(load())
+        self.assertEqual(len(rows), 600)
+        keys = [(-r["value_cents"], r["sku"]) for r in rows]
+        self.assertEqual(keys, sorted(keys))
+
+
+class CliTests(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run([sys.executable, "-m", "inventory", "report", *args],
+                              cwd=ROOT, capture_output=True, text=True, check=True).stdout
+
+    def test_cli_stdout_header_and_filter(self):
+        out = self.run_cli("--category", "garden", "--min-qty", "10")
+        rows = parse(out)
+        self.assertTrue(rows)
+        self.assertTrue(all(r["category"] == "garden" and int(r["qty"]) >= 10 for r in rows))
+        self.assertEqual(out.splitlines()[0], "sku,name,category,qty,price_cents,value_cents")
+
+    def test_cli_out_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "out.csv")
+            stdout = self.run_cli("--warehouse", "north", "--out", path)
+            self.assertEqual(stdout, "")
+            with open(path, newline="") as f:
+                rows = parse(f.read())
+        self.assertEqual(len(rows), len(report.build_rows(load(), warehouse="north")))
+        self.assertTrue(rows)
+
+
+if __name__ == "__main__":
+    unittest.main()
