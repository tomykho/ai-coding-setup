+import csv
+import sys
+
+from inventory.core import load
+
+FIELDS = ["sku", "name", "category", "qty", "price_cents", "value_cents"]
+
+
+def report_rows(items, category=None, warehouse=None, min_qty=None):
+    """Return filtered items as dicts with value_cents, sorted by value desc, sku asc."""
+    rows = []
+    for i in items:
+        if category is not None and i.category != category:
+            continue
+        if warehouse is not None and i.warehouse != warehouse:
+            continue
+        if min_qty is not None and i.qty < min_qty:
+            continue
+        rows.append({
+            "sku": i.sku,
+            "name": i.name,
+            "category": i.category,
+            "qty": i.qty,
+            "price_cents": i.price_cents,
+            "value_cents": i.qty * i.price_cents,
+        })
+    rows.sort(key=lambda r: (-r["value_cents"], r["sku"]))
+    return rows
+
+
+def write_report(rows, fh):
+    writer = csv.DictWriter(fh, fieldnames=FIELDS, lineterminator="\n")
+    writer.writeheader()
+    writer.writerows(rows)
+
+
+def main(argv=None):
+    import argparse
+
+    parser = argparse.ArgumentParser(prog="python3 -m inventory")
+    sub = parser.add_subparsers(dest="command", required=True)
+    rep = sub.add_parser("report", help="print stock value report as CSV")
+    rep.add_argument("--category")
+    rep.add_argument("--warehouse")
+    rep.add_argument("--min-qty", type=int)
+    rep.add_argument("--out")
+    args = parser.parse_args(argv)
+
+    rows = report_rows(load(), category=args.category,
+                       warehouse=args.warehouse, min_qty=args.min_qty)
+    if args.out:
+        with open(args.out, "w", newline="") as f:
+            write_report(rows, f)
+    else:
+        write_report(rows, sys.stdout)
+    return 0
