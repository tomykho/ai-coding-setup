+import csv
+import sys
+
+from .core import load
+
+HEADER = ["sku", "name", "category", "qty", "price_cents", "value_cents"]
+
+
+def build_rows(items, category=None, warehouse=None, min_qty=None):
+    """Filter items (AND-combined), add value_cents, sort by value desc then sku asc."""
+    rows = []
+    for i in items:
+        if category is not None and i.category != category:
+            continue
+        if warehouse is not None and i.warehouse != warehouse:
+            continue
+        if min_qty is not None and i.qty < min_qty:
+            continue
+        rows.append({
+            "sku": i.sku,
+            "name": i.name,
+            "category": i.category,
+            "qty": i.qty,
+            "price_cents": i.price_cents,
+            "value_cents": i.qty * i.price_cents,
+        })
+    rows.sort(key=lambda r: (-r["value_cents"], r["sku"]))
+    return rows
+
+
+def write_csv(rows, fh):
+    writer = csv.DictWriter(fh, fieldnames=HEADER, lineterminator="\n")
+    writer.writeheader()
+    writer.writerows(rows)
+
+
+def main(argv=None, items=None):
+    import argparse
+
+    parser = argparse.ArgumentParser(prog="inventory report")
+    parser.add_argument("--category")
+    parser.add_argument("--warehouse")
+    parser.add_argument("--min-qty", type=int)
+    parser.add_argument("--out")
+    args = parser.parse_args(argv)
+
+    if items is None:
+        items = load()
+    rows = build_rows(items, args.category, args.warehouse, args.min_qty)
+
+    if args.out:
+        with open(args.out, "w", newline="") as f:
+            write_csv(rows, f)
+    else:
+        write_csv(rows, sys.stdout)
+    return 0
