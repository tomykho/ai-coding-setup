#!/bin/sh
# git credential helper, mounted read-only in the sandbox next to the gh shim.
#
#   credential.https://github.com.helper = !gh-mint-credential
#   credential.https://github.com.useHttpPath = true
#
# useHttpPath is what makes this work for more than one App: git then passes
# path=<owner>/<repo>.git in the credential request, so the owner picks the App
# and each owner's token is minted from its own installation. Without it the
# helper would only see the host and could not tell repos apart.
#
# `git credential fill` runs this as `gh-mint-credential get`; `store`/`erase`
# (after a successful push) are no-ops because there is nothing to store.
set -eu

case ${1:-get} in
  get) ;;
  *) exit 0 ;;
esac

SOCK=${GH_MINT_SOCK:-/run/gh-mint.sock}
owner=

while IFS= read -r line; do
  [ -n "$line" ] || break
  case $line in
    path=*)
      p=${line#path=}
      p=${p#/}
      owner=${p%%/*}
      ;;
  esac
done

# Anything unexpected in the path falls back to the launcher's default owner
# rather than being pasted into a URL.
case $owner in
  '' | *[!A-Za-z0-9._-]*) owner=${GH_MINT_OWNER:-} ;;
esac

token=$(curl -sfN --max-time 20 --unix-socket "$SOCK" \
  "http://localhost/token${owner:+?owner=$owner}") || exit 1
[ -n "$token" ] || exit 1

printf 'username=x-access-token\npassword=%s\n' "$token"
